generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  DRAFT
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  ASK_AVAILABILITY
}

model User {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(254)
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  orders       Order[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique @db.VarChar(80)
  slug        String    @unique @db.VarChar(100)
  description String    @db.VarChar(500)
  symbol      String    @db.VarChar(12)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  nameEn String? @db.VarChar(120)
  nameFr String? @db.VarChar(120)
  nameAr String? @db.VarChar(120)
  nameMa String? @db.VarChar(120)
  descriptionEn String? @db.VarChar(500)
  descriptionFr String? @db.VarChar(500)
  descriptionAr String? @db.VarChar(500)
  descriptionMa String? @db.VarChar(500)
  id              String      @id @default(cuid())
  slug            String      @unique @db.VarChar(120)
  name            String      @db.VarChar(120)
  description     String      @db.VarChar(500)
  fullDescription String      @db.Text
  oldPriceMinor   Int?
  imageData       Bytes?
  imageDarkData   Bytes?
  imageLightData  Bytes?
  hasDarkImage    Boolean @default(false)
  hasLightImage   Boolean @default(false)
  hasImage        Boolean     @default(false)
  durationMonths  Int?
  apiCreditUsd    Int?
  activation      String? @db.VarChar(120)
  priceMinor      Int
  badge           String      @db.VarChar(40)
  featured        Boolean     @default(false)
  active          Boolean     @default(true)
  availability    AvailabilityStatus @default(AVAILABLE)
  releasedAt      DateTime
  symbol          String      @db.VarChar(12)
  color           String      @db.VarChar(20)
  features        String[]
  format          String      @db.VarChar(80)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([categoryId, active])
  @@index([active, featured, releasedAt])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         OrderStatus @default(DRAFT)
  currency       String      @default("MAD") @db.Char(3)
  totalMinor     Int
  customerName   String      @db.VarChar(161)
  customerEmail  String      @db.VarChar(254)
  company        String?     @db.VarChar(120)
  idempotencyKey String      @db.VarChar(36)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String   @db.VarChar(120)
  productSlug    String   @db.VarChar(120)
  unitPriceMinor Int
  quantity       Int      @default(1)

  @@index([orderId])
  @@index([productId])
}
