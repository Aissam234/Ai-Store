# Copy to .env.local. PostgreSQL must exist before migrating.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexora?schema=public"

# Optional initial admin; omit BOTH email and password to seed products only.
# Use a unique email and a strong password (15–128 characters). No defaults are created.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Store administrator"

# Defaults to true in production, false in development.
# Only set false for local HTTP/LAN testing. Production authentication requires HTTPS.
SESSION_COOKIE_SECURE="true"

# Optional compose.yaml database (binds to localhost:55432). Match DATABASE_URL password.
POSTGRES_PASSWORD=""
